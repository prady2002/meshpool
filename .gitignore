# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# --- Test / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- MeshPool runtime artifacts ---
# Sim scenarios + the verify_lan proof write ephemeral cluster state into _data_* dirs
# (under sim/scenarios/ and at the repo root); ignore them wherever they appear.
_data_*/
sim/scenarios/_data_*/
# SQLite datastores created at runtime (the tracked demo weights .npz is kept).
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# Scratch files produced by manual/e2e probes.
_sec.txt
_*.txt
_probe_*.py
_gatelogs/
full_suite_out*.txt
# JUnit XML reports written by ad-hoc pytest --junitxml runs.
report_*.xml
# First-run marker written next to the launcher scripts in an extracted build.
.meshpool-deps-ok

# --- Editor / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
meshpool_build_spec.md
# --- Ad-hoc run logs ---
# Gate/pytest output captured via PowerShell redirection. These have previously been
# committed by accident and contained a private IP and live invite tokens, so the
# pattern is ignored rather than relying on discipline.
pytest_*.txt
*_out.txt
*_out[0-9].txt
_gatelogs/
*.log

# scratch file used to pass multi-line commit messages to git commit -F
.commitmsg

# The raw session prompt that drove this work. Useful locally, but it is a
# personal note rather than product documentation and should not greet anyone
# who clones the repo.
prompt.md

# Crash-recovery journals written by the in-place mutation gates. Present only
# while a non-vacuity check is mid-mutation, or after one was killed -- in
# which case `python -m sim.mutation_guard` restores the file and clears them.
.mutation-journal/
.mutation-journal-test/
