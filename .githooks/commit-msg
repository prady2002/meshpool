#!/usr/bin/env python
"""Strip a leading UTF-8/UTF-16 BOM from the commit message.

On Windows, `Set-Content` / `Out-File` / `>` prepend a byte-order mark, and
`git commit -F <file>` copies that BOM verbatim into the commit subject.  The
result is a commit whose subject begins with an invisible U+FEFF, which breaks
`git log --grep`, subject-line linting, and changelog generation.

This hook is idempotent and rewrites the file only when a BOM is present.
Enable with:  git config core.hooksPath .githooks
"""
import sys
import pathlib

BOMS = (
    (b"\xef\xbb\xbf", "utf-8"),
    (b"\xff\xfe", "utf-16-le"),
    (b"\xfe\xff", "utf-16-be"),
)


def main() -> int:
    path = pathlib.Path(sys.argv[1])
    raw = path.read_bytes()
    for bom, encoding in BOMS:
        if not raw.startswith(bom):
            continue
        body = raw[len(bom):]
        if encoding != "utf-8":
            # PowerShell's `*>` and `Out-File` default to UTF-16LE; re-encode so
            # the message is not stored as NUL-interleaved bytes.
            body = body.decode(encoding, "replace").encode("utf-8")
        path.write_bytes(body)
        print(f"commit-msg: stripped {encoding} BOM from commit message", file=sys.stderr)
        return 0
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
